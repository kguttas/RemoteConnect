<Window x:Class="RemoteConnect.UI.RemoteFilesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Archivos del equipo remoto" Width="820" Height="560" MinWidth="520" MinHeight="320"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Icon="/Assets/app.ico">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="True">
            <Button x:Name="UpButton" DockPanel.Dock="Left" Content="&#xE74A;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                    ToolTip="Subir un nivel" Click="OnUp" Padding="10,4" />
            <Button DockPanel.Dock="Left" Content="&#xE80F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                    ToolTip="Inicio: unidades y carpetas del usuario" Click="OnHome" Padding="10,4" Margin="4,0,0,0" />
            <Button DockPanel.Dock="Right" Content="&#xE72C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                    ToolTip="Actualizar" Click="OnRefresh" Padding="10,4" Margin="4,0,0,0" />
            <TextBox x:Name="PathBox" Margin="4,0,0,0" VerticalContentAlignment="Center" KeyDown="OnPathKey"
                     ToolTip="Escribe una ruta del equipo remoto y pulsa Intro" />
        </DockPanel>

        <Grid Grid.Row="1">
            <ListView x:Name="List" SelectionMode="Extended" MouseDoubleClick="OnItemDoubleClick" KeyDown="OnListKey"
                      SelectionChanged="OnSelectionChanged">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Nombre" Width="400">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Icon}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,0,8,0"
                                                   VerticalAlignment="Center" Foreground="{Binding IconBrush}" />
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Tamaño" Width="140">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding SizeText}" TextAlignment="Right" MinWidth="120" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Modificado" Width="170" DisplayMemberBinding="{Binding ModifiedText}" />
                    </GridView>
                </ListView.View>
            </ListView>
            <TextBlock x:Name="EmptyText" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.7"
                       TextWrapping="Wrap" TextAlignment="Center" MaxWidth="420" Visibility="Collapsed" />
        </Grid>

        <Grid Grid.Row="2" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="StatusText" TextTrimming="CharacterEllipsis" />
                <ProgressBar x:Name="Progress" Height="4" Margin="0,6,0,0" Visibility="Collapsed" Maximum="1" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0">
                <Button x:Name="CancelButton" Content="Cancelar" Click="OnCancel" Visibility="Collapsed" Margin="0,0,6,0" />
                <Button x:Name="DownloadButton" Content="Descargar" Click="OnDownload" IsEnabled="False"
                        Style="{DynamicResource AccentButtonStyle}" MinWidth="110" />
            </StackPanel>
        </Grid>

        <DockPanel Grid.Row="3" Margin="0,8,0,0">
            <TextBlock DockPanel.Dock="Left" Text="Se guardan en:" VerticalAlignment="Center" Opacity="0.7" />
            <Button DockPanel.Dock="Right" Content="Abrir carpeta" Click="OnOpenFolder" Margin="6,0,0,0" />
            <Button DockPanel.Dock="Right" Content="Cambiar…" Click="OnChangeFolder" Margin="6,0,0,0" />
            <TextBlock x:Name="FolderText" Margin="6,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </DockPanel>
    </Grid>
</Window>
